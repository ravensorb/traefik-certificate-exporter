{
  "$id": "https://github.com/ravensorb/traefik-certificate-exporter/schemas/release-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "complete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "failures": {
            "maxItems": 0
          },
          "forge_release": {
            "properties": {
              "assets": {
                "minItems": 1
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "const": "published"
              },
              "url": {
                "format": "uri",
                "pattern": "^https://",
                "type": "string"
              }
            }
          },
          "package": {
            "properties": {
              "destinations": {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "forge"
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "items": {
                  "if": {
                    "properties": {
                      "outcome": {
                        "const": "published"
                      }
                    },
                    "required": [
                      "outcome"
                    ]
                  },
                  "then": {
                    "properties": {
                      "artifacts": {
                        "items": {
                          "properties": {
                            "remote_sha256": {
                              "$ref": "#/$defs/hash"
                            },
                            "status": {
                              "const": "published"
                            }
                          }
                        },
                        "minItems": 2
                      }
                    }
                  }
                }
              }
            }
          },
          "oci": {
            "properties": {
              "images": {
                "contains": {
                  "properties": {
                    "name": {
                      "const": "forge"
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "items": {
                  "if": {
                    "properties": {
                      "outcome": {
                        "const": "published"
                      }
                    },
                    "required": [
                      "outcome"
                    ]
                  },
                  "then": {
                    "properties": {
                      "digest": {
                        "$ref": "#/$defs/digest"
                      },
                      "platforms": {
                        "minItems": 1
                      }
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          "reconciliation": {
            "properties": {
              "git_aliases": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "const": "matched"
                    }
                  }
                }
              },
              "oci_aliases": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "const": "matched"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "failures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "enum": [
              "forge-release",
              "oci",
              "package",
              "reconciliation"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "destination",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "forge_release": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/remoteArtifact"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/mutationStatus"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "pattern": "^https://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "url",
        "status",
        "assets"
      ],
      "type": "object"
    },
    "oci": {
      "additionalProperties": false,
      "properties": {
        "images": {
          "items": {
            "$ref": "#/$defs/imageDestination"
          },
          "type": "array"
        }
      },
      "required": [
        "images"
      ],
      "type": "object"
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "destinations": {
          "items": {
            "$ref": "#/$defs/packageDestination"
          },
          "type": "array"
        }
      },
      "required": [
        "destinations"
      ],
      "type": "object"
    },
    "package_version": {
      "minLength": 1,
      "type": "string"
    },
    "reconciliation": {
      "additionalProperties": false,
      "properties": {
        "git_aliases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "actual_sha": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/sourceSha"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "alias": {
                "$ref": "#/$defs/safeName"
              },
              "expected_sha": {
                "$ref": "#/$defs/sourceSha"
              },
              "status": {
                "$ref": "#/$defs/reconciliationStatus"
              }
            },
            "required": [
              "alias",
              "expected_sha",
              "actual_sha",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "oci_aliases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "actual_digest": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/digest"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "alias": {
                "$ref": "#/$defs/safeName"
              },
              "expected_digest": {
                "$ref": "#/$defs/digest"
              },
              "status": {
                "$ref": "#/$defs/reconciliationStatus"
              }
            },
            "required": [
              "alias",
              "expected_digest",
              "actual_digest",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "oci_aliases",
        "git_aliases"
      ],
      "type": "object"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "schema_version": {
      "const": "release-receipt-v1"
    },
    "source_sha": {
      "$ref": "#/$defs/sourceSha"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "package_version",
    "source_sha",
    "package",
    "oci",
    "forge_release",
    "reconciliation",
    "failures",
    "run"
  ],
  "title": "Release receipt v1",
  "type": "object",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "endpoint": {
      "format": "uri",
      "pattern": "^https://",
      "type": "string"
    },
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "imageDestination": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "forge"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "not": {
                  "const": "disabled"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "enum": [
            "dockerhub",
            "forge"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/imageDestinationOutcome"
        },
        "platforms": {
          "items": {
            "pattern": "^linux/[a-z0-9_]+(?:/v[0-9]+)?$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "registry": {
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "registry",
        "repository",
        "digest",
        "platforms",
        "outcome"
      ],
      "type": "object"
    },
    "imageDestinationOutcome": {
      "enum": [
        "disabled",
        "failed",
        "pending",
        "published"
      ]
    },
    "mutationStatus": {
      "enum": [
        "failed",
        "pending",
        "published"
      ]
    },
    "packageDestination": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "outcome": {
                "not": {
                  "const": "absent-by-host"
                }
              }
            }
          },
          "if": {
            "properties": {
              "name": {
                "const": "forge"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "not": {
                  "const": "disabled"
                }
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "endpoint": {
                "$ref": "#/$defs/endpoint"
              }
            }
          },
          "if": {
            "properties": {
              "outcome": {
                "const": "absent-by-host"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "artifacts": {
                "maxItems": 0
              },
              "endpoint": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/remoteArtifact"
          },
          "type": "array",
          "uniqueItems": true
        },
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/endpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "enum": [
            "forge",
            "pypi",
            "testpypi"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/packageDestinationOutcome"
        }
      },
      "required": [
        "name",
        "endpoint",
        "outcome",
        "artifacts"
      ],
      "type": "object"
    },
    "packageDestinationOutcome": {
      "enum": [
        "absent-by-host",
        "disabled",
        "failed",
        "pending",
        "published"
      ]
    },
    "reconciliationStatus": {
      "enum": [
        "failed",
        "matched",
        "mismatched",
        "missing",
        "pending",
        "unverifiable"
      ]
    },
    "remoteArtifact": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "$ref": "#/$defs/safeName"
        },
        "remote_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "status": {
          "$ref": "#/$defs/mutationStatus"
        }
      },
      "required": [
        "filename",
        "sha256",
        "remote_sha256",
        "status"
      ],
      "type": "object"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "run_attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "server_url": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string"
        }
      },
      "required": [
        "server_url",
        "repository",
        "run_id",
        "run_attempt"
      ],
      "type": "object"
    },
    "safeName": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
      "type": "string"
    },
    "sourceSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  }
}
