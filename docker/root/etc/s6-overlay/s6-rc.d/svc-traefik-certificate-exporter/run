#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# The privilege decision is made by init-traefik-certificate-exporter-config (a declared
# dependency of this service) and read here as a single value, so this script keeps one
# `s6-setuidgid` call at the top of its exec chain. A missing state file means that init
# never ran: drop privileges, which is the safe side of the fallback.
STATE_DIR=/run/traefik-certificate-exporter
PRIV_STATE="${STATE_DIR}/run-as-root"
SERVICE_HOME="${STATE_DIR}/home"

if [[ "$TRAEFIK_CERTIFICATE_EXPORTER_SETTINGS_WATCHFORCHANGES" == "true" || "$TRAEFIK_CERTIFICATE_EXPORTER_SETTINGS_WATCHFORCHANGES" == "1" ]]; then
    echo "Starting application..."

    if [[ "$(cat "$PRIV_STATE" 2> /dev/null)" == "true" ]]; then
        echo "WARNING: running as root because settings.restartcontainers is enabled," \
             "which requires Docker socket access. Disable settings.restartcontainers to" \
             "run as the unprivileged PUID/PGID account (abc), or put an endpoint-restricted" \
             "docker-socket proxy in front of the socket (see docs/operational.md)."

        exec \
            s6-setuidgid root \
            traefik-certificate-exporter -c /config/config.yaml
    fi

    # `s6-setuidgid` changes the uid/gid and nothing else, so without this the service would
    # run as abc with HOME=/root (mode 0700) and die in confuse's unconditional
    # `makedirs($HOME/.config/...)` before reading anything. init owns this directory to abc.
    export HOME="${SERVICE_HOME}"

    exec \
        s6-setuidgid abc \
        traefik-certificate-exporter -c /config/config.yaml
else
    echo "Skipping start of application..."
    # env | sort
fi
