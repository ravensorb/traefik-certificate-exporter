#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Seed the operator's config on first boot, then decide -- once, here -- whether the service
# may drop root. It drops to the PUID/PGID account only when that account is PROVEN able to do
# the job: settings.restartcontainers is off (the Docker socket needs root), every ACME store
# file the application will read is readable by it, and the output path is writable by it
# (ADR-0030, amended 2026-10-10). Anything unproven keeps root and logs one WARNING saying
# why. The answer is written to a state file the service script reads, so the service script
# keeps a single `s6-setuidgid` call at the top of its exec chain.
#
# The same resolver also answers the service's run mode -- watch, or run once and stop the
# container -- into its own state file, `watch-for-changes`, which the service's `run` and
# `finish` read (ADR-0044). It is a separate file because `resolved-settings` has a
# positional layout the privilege helper reads.
#
# The resolution is done by the INSTALLED package, not by a second parser living here: the
# container must reach the same answer the application will, across every source confuse
# merges (packaged default, .env files, config file, environment) and with confuse's own
# truthiness -- and the ACME store files are the application's own `glob.glob` matches, not a
# shell re-derivation of `settings.filespec`.

CONFIG_FILE=/config/config.yaml
STATE_DIR=/run/traefik-certificate-exporter
PRIV_STATE="${STATE_DIR}/run-as-root"
RESOLVED="${STATE_DIR}/resolved-settings"
RUN_MODE="${STATE_DIR}/watch-for-changes"
SERVICE_HOME="${STATE_DIR}/home"
SERVICE_USER=abc
PRIV_HELPER=/usr/local/lib/traefik-certificate-exporter/privilege-decision.sh
PYTHON=/app/.venv/bin/python

# Replace the state file atomically, so the service never reads a half-written answer.
write_priv_state() {
    printf '%s\n' "$1" > "${PRIV_STATE}.tmp" && mv -f "${PRIV_STATE}.tmp" "${PRIV_STATE}"
}

if [ ! -f "${CONFIG_FILE}" ]; then
    echo "Setting up sample config.yaml"
    cp -u /defaults/config/config.yaml.sample "${CONFIG_FILE}"
fi

mkdir -p "${STATE_DIR}"

# Fail safe before anything can go wrong: nothing has been proven yet, so the answer on disk
# is "keep root" until the decision below proves the unprivileged account viable. A stale
# resolution from a previous boot must never be read as this boot's answer.
printf 'true\n' > "${PRIV_STATE}"
rm -f "${RESOLVED}" "${RUN_MODE}"

# Written to a file rather than captured from stdout: loading the settings also initialises
# the application logger, and its output must not be mistaken for the answer. Written
# atomically (temp + os.replace) so a crash leaves no file rather than a partial one; a path
# containing a newline cannot be represented one-per-line, so it writes nothing at all.
TCE_CONFIG_FILE="${CONFIG_FILE}" TCE_RESOLVED_OUT="${RESOLVED}" TCE_RUN_MODE_OUT="${RUN_MODE}" \
    "${PYTHON}" - > /dev/null 2>&1 <<'PY'
import glob
import os
import tempfile

from traefik_certificate_exporter.libs.settings import SettingsManager

manager = SettingsManager()
manager.loadFromFile(os.environ["TCE_CONFIG_FILE"])
settings = manager.settings


def write_atomically(out, text, prefix):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(out), prefix=prefix)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(tmp, out)


# The run mode first: it depends on no path, so a store path the privilege answer cannot
# represent must not also cost the service its mode. Optional, so a caller that wants only
# the privilege answer sets only TCE_RESOLVED_OUT.
runModeOut = os.environ.get("TCE_RUN_MODE_OUT")
if runModeOut:
    write_atomically(
        runModeOut, "true\n" if settings.watchForChanges else "false\n", ".run-mode-"
    )

# The same expression the exporter uses to enumerate the store (exportCertificates).
matches = sorted(
    os.path.abspath(path)
    for path in glob.glob(os.path.join(settings.dataPath, settings.fileSpec))
)
lines = [
    "true" if settings.restartContainers else "false",
    str(settings.outputPath),
    str(settings.dataPath),
    str(settings.fileSpec),
    *matches,
]
if any("\n" in line or "\r" in line for line in lines):
    raise SystemExit("a resolved path contains a newline")

write_atomically(
    os.environ["TCE_RESOLVED_OUT"], "".join(f"{line}\n" for line in lines), ".resolved-"
)
PY

# ---- privilege decision: begin ----
# Only the exact answers `true`/`false` are accepted; a missing helper, a failed source, or
# any other output keeps root.
decision=""
# shellcheck source=../../../../usr/local/lib/traefik-certificate-exporter/privilege-decision.sh
# shellcheck disable=SC1091 # Not followed: the shellcheck hook lints the helper as its own input.
if [ -r "${PRIV_HELPER}" ] && . "${PRIV_HELPER}" \
    && declare -F tce_privilege_decision > /dev/null; then
    decision="$(tce_privilege_decision "${RESOLVED}" "${SERVICE_USER}")"
fi

case "${decision}" in
    true | false)
        write_priv_state "${decision}"
        ;;
    *)
        decision=true
        write_priv_state true
        echo "WARNING: running as root (privilege decision failed)"
        ;;
esac
# ---- privilege decision: end ----

if [ "${decision}" = "true" ]; then
    exit 0
fi

# ---- From here on the service will run as ${SERVICE_USER}; make that account viable. ----

# confuse creates its application directory under $HOME on every start, and $HOME is /root in
# the base image -- mode 0700, so the unprivileged account cannot create it and the service
# would die before reading a single certificate. Give it a home it owns, on tmpfs.
mkdir -p "${SERVICE_HOME}"
chown "${SERVICE_USER}:${SERVICE_USER}" "${SERVICE_HOME}"

# The output path is resolved, not assumed: /certs is only the image's DEFAULT outputpath, and
# an operator who mounts somewhere else would otherwise get a root-owned directory the service
# cannot write to, reported only as a per-domain export error.
outputPath=""
{ IFS= read -r _ && IFS= read -r outputPath; } 2> /dev/null < "${RESOLVED}"
[ -n "${outputPath}" ] || outputPath=/certs

if [ -d "${outputPath}" ]; then
    # NOT `chown -R` and NOT `lsiown -R`: both dereference symlinks, so a link planted in the
    # operator-writable output volume would have this root-owned init chown its target --
    # turning the privilege drop into an arbitrary-chown primitive aimed at /etc/shadow.
    # `! -type l` skips links outright and `-xdev` stops at a nested mount.
    find "${outputPath}" -xdev ! -type l -exec chown -h "${SERVICE_USER}:${SERVICE_USER}" {} + || \
        echo "INFO: could not take ownership of every file under ${outputPath} for ${SERVICE_USER}"
fi

# Decision row 6: the drop is only viable if the account can now write the output path.
if ! declare -F tce_output_writable > /dev/null; then
    write_priv_state true
    echo "WARNING: running as root (privilege decision failed)"
elif ! tce_output_writable "${outputPath}" "${SERVICE_USER}"; then
    write_priv_state true
fi
