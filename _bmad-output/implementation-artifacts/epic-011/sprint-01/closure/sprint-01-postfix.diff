+    """The unwind path re-arms whatever the interrupted drain did not finish -- but a
+    KeyboardInterrupt mid-drain IS the shutdown, and nothing would cancel the new timer."""
+    exporter = MagicMock()
+    handler = _handler(exporter)
+
+    def interrupt(_path):
+        # The Ctrl-C lands DURING the drain, which is exactly the case the unwind guard
+        # exists for: the latch re-check at drain entry cannot have seen it yet.
+        handler.shuttingDown = True
+        raise KeyboardInterrupt
+
+    exporter.exportCertificatesForFile.side_effect = interrupt
+
+    handler.handleEvent(_event("/data/a.json"))
+    handler.handleEvent(_event("/data/b.json"))
+    handler.timer.cancel()
+    timerAtShutdown = handler.timer
+
+    with caplog.at_level(logging.WARNING), pytest.raises(KeyboardInterrupt):
+        handler.doTheWork(handler.correlationId)
+
+    assert handler.isWaiting is False
+    assert handler.timer is timerAtShutdown, (
+        "the unwind path re-armed a drain during shutdown"
+    )
+    assert any(
+        "will not be exported by this process" in r.getMessage() for r in caplog.records
+    ), "work abandoned at shutdown was dropped without saying so"
+
+
+def test_cancel_does_not_wait_forever_on_a_slow_drain(monkeypatch, caplog):
+    """A non-daemon Timer thread stuck in a slow export must not hold the process open
+    past the container runtime's grace period."""
+    monkeypatch.setattr(certificate_exporter, "WATCH_DEBOUNCE_SECONDS", 0.01)
+    monkeypatch.setattr(certificate_exporter, "SHUTDOWN_JOIN_TIMEOUT_SECONDS", 0.1)
+
+    release = threading.Event()
+    started = threading.Event()
+
+    def slow(path):
+        started.set()
+        release.wait(10)
+        return ["example.com"]
+
+    exporter = MagicMock()
+    exporter.exportCertificatesForFile.side_effect = slow
+    handler = _handler(exporter)
+
+    handler.handleEvent(_event("/data/acme.json"))
+    assert started.wait(5)
+
+    began = time.monotonic()
+    with caplog.at_level(logging.WARNING):
+        handler.cancel()
+    elapsed = time.monotonic() - began
+
+    release.set()
+    handler.timer.join(10)
+
+    assert elapsed < 5, f"shutdown blocked on an in-flight drain for {elapsed:.1f}s"
+    assert any("abandoning it" in r.getMessage() for r in caplog.records)
+
+
+###########################################################################################
+# SD-01-1 / AD-02: ADR-0023 Amendment 4a asserts shutdown can tell an armed window from a
+# running one. `draining` used to be published part-way into `doTheWork`, so `cancel()`
+# could report a pass that in fact ran as "cancelled". Both halves are driven by an
+# injected fault -- a drain fired deliberately into the shutdown window.
+
+
+def test_a_drain_that_starts_after_the_shutdown_latch_exports_nothing(caplog):
+    """The latch is set, THEN the timer target runs. Nothing may be exported."""
+    exporter = MagicMock()
+    exporter.exportCertificatesForFile.return_value = ["example.test"]
+    handler = _handler(exporter)
+
+    handler.handleEvent(_event("/data/acme.json"))
+    handler.timer.cancel()  # the timer must not also fire on its own
+    correlationId = handler.correlationId
+
+    handler.cancel()
+    exporter.exportCertificatesForFile.reset_mock()
+
+    with caplog.at_level(logging.WARNING):
+        # Exactly what a timer that had already fired would do.
+        handler._AcmeCertificateFileHandler__drainWindow(correlationId)
+
+    exporter.exportCertificatesForFile.assert_not_called()
+    assert handler.draining is False
+    abandoned = [r for r in caplog.records if "abandoning it" in r.getMessage()]
+    assert abandoned, "a drain abandoned at the latch said nothing about it"
+    assert abandoned[0].correlation_id == correlationId
+
+
+def test_cancel_never_claims_cancelled_for_a_drain_that_actually_ran(monkeypatch):
+    """The race, driven through the REAL timer: `cancel()` lands around the moment the
+    debounce fires, over enough iterations that both orderings occur."""
+    monkeypatch.setattr(certificate_exporter, "SHUTDOWN_JOIN_TIMEOUT_SECONDS", 5)
+
+    sawRan = False
+    sawCancelled = False
+
+    for i in range(60):
+        monkeypatch.setattr(
+            certificate_exporter, "WATCH_DEBOUNCE_SECONDS", (i % 10) * 0.002
+        )
+
+        exporter = MagicMock()
+        exporter.exportCertificatesForFile.return_value = ["example.test"]
+        handler = _handler(exporter)
+
+        messages: list[str] = []
+        handler._AcmeCertificateFileHandler__logger = SimpleNamespace(
+            info=lambda m, _s=messages: _s.append(m),
+            warning=lambda m, _s=messages: _s.append(m),
+            debug=lambda *a, **k: None,
+            exception=lambda *a, **k: None,
+        )
+
+        handler.handleEvent(_event("/data/acme.json"))
+        handler.cancel()
+        handler.timer.join(10)
+
+        ran = exporter.exportCertificatesForFile.called
+        saidCancelled = any("cancelled the pending export drain" in m for m in messages)
+
+        assert not (ran and saidCancelled), (
+            "cancel() reported a drain that ran as cancelled: " + "; ".join(messages)
+        )
+        assert handler.drainsRun == (1 if ran else 0), (
+            "the drain counter disagrees with whether an export happened"
+        )
+        sawRan = sawRan or ran
+        sawCancelled = sawCancelled or saidCancelled
+
+    assert sawCancelled, "the cancel-before-fire ordering never occurred; test is inert"
diff --git a/tests/libs/test_cli_args.py b/tests/libs/test_cli_args.py
new file mode 100644
index 0000000..4c62115
--- /dev/null
+++ b/tests/libs/test_cli_args.py
@@ -0,0 +1,141 @@
+"""Guards for the two-path CLI parse (ADR-0025, BL-E001-006).
+
+The import-time parse must stay lenient -- it runs whenever anything imports the package,
+including under pytest, where argv belongs to pytest and not to us. The production parse
+must be strict -- there argv is this process's own, so an unrecognized flag is a typo.
+Both halves are asserted here, because fixing either one alone reintroduces the other's
+bug.
+
+argparse objects are first-class and parse an explicit list, so none of this needs a
+subprocess or any argv monkeypatching.
+"""
+
+import argparse
+import subprocess
+import sys
+
+import pytest
+
+from traefik_certificate_exporter.libs.cli_args import (
+    globalArgParser,
+    globalArgs,
+    parse_args_strict,
+)
+
+
+def test_import_time_parse_is_lenient_about_foreign_argv():
+    """The guarantee the import-time assignment exists for.
+
+    This test module was itself imported by pytest, whose argv (`-x`, `-v`, a node id)
+    `cli_args` has already parsed at import time. Reaching this assertion at all means no
+    SystemExit was raised during that import -- which is the regression BL-E001-006's fix
+    must not reintroduce.
+    """
+    assert isinstance(globalArgs, argparse.Namespace)
+    assert globalArgs.configfile == "config.yaml"
+
+
+def test_lenient_parse_silently_ignores_a_typo():
+    """`--dtaa-path` is a typo for `--data-path`, and the lenient path keeps going."""
+    parsed, unknown = globalArgParser.parse_known_args(["--dtaa-path", "/x"])
+
+    assert unknown == ["--dtaa-path", "/x"]
+    assert getattr(parsed, "settings.datapath") is None
+
+
+def test_strict_parse_rejects_a_typo(capsys):
+    """The behavior BL-E001-006 asks for: a typo is an error, not a silent no-op."""
+    with pytest.raises(SystemExit) as excinfo:
+        globalArgParser.parse_args(["--dtaa-path", "/x"])
+
+    assert excinfo.value.code == 2
+    assert "--dtaa-path" in capsys.readouterr().err
+
+
+def test_strict_parse_accepts_a_valid_invocation():
+    """Strictness must not cost a correct command line its parse."""
+    parsed = globalArgParser.parse_args(
+        ["--data-path", "/acme", "--log-level", "DEBUG"]
+    )
+
+    assert getattr(parsed, "settings.datapath") == "/acme"
+    assert parsed.logginglevel == "DEBUG"
+
+
+def test_strict_parse_still_prints_help_and_exits_zero(capsys):
+    """`-h` is handled by argparse's own action, before unrecognized-arg handling."""
+    with pytest.raises(SystemExit) as excinfo:
+        globalArgParser.parse_args(["-h"])
+
+    assert excinfo.value.code == 0
+    assert "usage:" in capsys.readouterr().out
+
+
+def test_parse_args_strict_reads_process_argv(monkeypatch):
+    """`parse_args_strict()` is `parse_args()` over `sys.argv` -- nothing in between.
+
+    Asserted through `sys.argv` rather than by passing a list, because the production
+    call in `main()` takes no argument and the thing worth guarding is that it reads the
+    real invocation.
+    """
+    monkeypatch.setattr(sys, "argv", ["traefik-certificate-exporter", "-d", "/acme"])
+
+    parsed = parse_args_strict()
+
+    assert getattr(parsed, "settings.datapath") == "/acme"
+
+
+def test_parse_args_strict_exits_on_an_unrecognized_flag(monkeypatch):
+    monkeypatch.setattr(
+        sys, "argv", ["traefik-certificate-exporter", "--dtaa-path", "/x"]
+    )
+
+    with pytest.raises(SystemExit) as excinfo:
+        parse_args_strict()
+
+    assert excinfo.value.code == 2
+
+
+def test_importing_app_under_foreign_argv_does_not_exit(monkeypatch):
+    """Importing never parses strictly -- only `main()` does.
+
+    `app.py` holds the only production call to `parse_args_strict()`, so a future edit
+    that hoists it to module scope would turn every import of the package into a
+    SystemExit under any host that owns argv. Re-importing with hostile argv present is
+    what catches that.
+    """
+    monkeypatch.setattr(sys, "argv", ["pytest", "--dtaa-path", "/x", "-k", "something"])
+    monkeypatch.delitem(sys.modules, "traefik_certificate_exporter.app", raising=False)
+    monkeypatch.delitem(
+        sys.modules, "traefik_certificate_exporter.libs.cli_args", raising=False
+    )
+
+    import importlib
+
+    module = importlib.import_module("traefik_certificate_exporter.app")
+
+    assert callable(module.main)
+
+
+def test_main_hard_fails_on_a_typo_end_to_end():
+    """The whole point, exercised through the real entry point in a real process.
+
+    Every other assertion here works on parser objects; this one proves the wiring --
+    that `main()` actually calls the strict parse, and does it before reading any
+    attribute of `globalArgs` or touching the filesystem.
+    """
+    result = subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            "from traefik_certificate_exporter.app import main; main()",
+            "--dtaa-path",
+            "/x",
+        ],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+
+    assert result.returncode == 2
+    assert "--dtaa-path" in result.stderr
